<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Indo" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/indo_background</item>
        <item name="android:navigationBarColor">@color/indo_background</item>
        <item name="android:windowBackground">@color/indo_background</item>

        <!-- Android 12+ system splash: one splash only, no second Compose splash. -->
        <item name="android:windowSplashScreenBackground">@color/indo_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/indo_splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
